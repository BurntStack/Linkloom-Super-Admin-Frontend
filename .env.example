# Linkloom Super Admin: environment settings.
# Copy this file to .env.local (git ignores it) and change what you need. Every value has a default,
# so the console also runs with no env file at all.
# Vite reads, in order: .env, .env.local, .env.[mode], .env.[mode].local (mode is "development" for
# `npm run dev`, "production" for `npm run build`). Only VITE_* values reach the browser bundle.

# ---- the browser ----

# Where the browser sends API calls. Keep the same-origin proxy (/api) unless the backend sends CORS
# headers for this console's origin; then you may point it straight at the API, e.g.
# VITE_API_BASE=https://collab-api-ewju.onrender.com
VITE_API_BASE=/api

# Admin emails must end in this domain. Set it empty (VITE_ADMIN_EMAIL_DOMAIN=) to allow any address.
VITE_ADMIN_EMAIL_DOMAIN=linkloom.in

# How long one API call may take, in milliseconds. The Render server sleeps when idle and can take
# close to a minute to wake up.
VITE_API_TIMEOUT_MS=45000

# ---- the dev and preview servers only (never sent to the browser) ----

# The backend that /api is proxied to by `npm run dev` and `npm run preview`.
# Use http://localhost:8000 for a backend running on your machine.
LINKLOOM_API=https://collab-api-ewju.onrender.com

# Port for `npm run dev` and `npm run preview`.
PORT=5173

# Production hosting: the proxy is the host's job. vercel.json forwards /api/* to the backend on Vercel;
# change its destination there if the backend moves.
