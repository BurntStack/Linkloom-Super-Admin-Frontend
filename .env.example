# Copy to .env.local to change these. All are optional.

# Where the browser sends API calls. The default is the same-origin proxy.
# VITE_API_BASE=/api

# Set to "off" to run the whole console on sample data.
# VITE_LIVE_API=off

# Dev and preview servers only: the backend that /api is proxied to.
# LINKLOOM_API=https://collab-api-ewju.onrender.com
